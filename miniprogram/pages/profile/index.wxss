.page {
  padding: 24rpx 0 40rpx;
}

.profile {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #eef1ff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  flex-shrink: 0;
}

.profile-body {
  flex: 1;
}

.profile-name {
  font-size: 34rpx;
  font-weight: 600;
}

.profile-id {
  margin-top: 6rpx;
  font-size: 22rpx;
}

.phone-btn {
  margin: 0;
  font-size: 26rpx;
  padding: 0 24rpx;
  background: #2f54eb;
  color: #fff;
  border-radius: 999rpx;
  line-height: 64rpx;
}

.phone-text {
  font-size: 26rpx;
}

.menu {
  margin-top: 24rpx;
}

.arrow {
  font-size: 40rpx;
  font-weight: 300;
}