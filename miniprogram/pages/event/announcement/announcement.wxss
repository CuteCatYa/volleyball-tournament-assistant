.page { padding: 24rpx; padding-bottom: 80rpx; }
.sec { font-size: 28rpx; font-weight: 600; margin-bottom: 12rpx; }
.n-input { background: #f5f6fa; border-radius: 12rpx; padding: 20rpx; font-size: 28rpx; }
.n-ta { width: 100%; min-height: 200rpx; box-sizing: border-box; background: #f5f6fa; border-radius: 12rpx; padding: 20rpx; margin-top: 16rpx; font-size: 28rpx; }
.btn-primary { margin-top: 20rpx; background: #2f54eb; color: #fff; border-radius: 999rpx; font-size: 30rpx; font-weight: 600; }
.sec-title { margin: 32rpx 8rpx 8rpx; font-size: 28rpx; font-weight: 600; color: #5f6572; }
.empty { text-align: center; color: #b0b4bf; font-size: 26rpx; padding: 40rpx; }
.n-title { font-size: 30rpx; font-weight: 600; }
.n-content { margin-top: 8rpx; font-size: 26rpx; color: #5f6572; line-height: 1.6; }
.n-meta { margin-top: 12rpx; font-size: 22rpx; color: #b0b4bf; }
