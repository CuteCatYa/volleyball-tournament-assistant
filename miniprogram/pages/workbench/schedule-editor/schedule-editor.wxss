.page { padding: 24rpx; padding-bottom: 80rpx; }
.btn-primary { margin-top: 8rpx; background: #2f54eb; color: #fff; border-radius: 999rpx; font-size: 30rpx; font-weight: 600; }
.btn-ghost { margin-top: 16rpx; background: #fff; color: #2f54eb; border: 2rpx solid #2f54eb; border-radius: 999rpx; font-size: 28rpx; }
.summary { margin: 16rpx 8rpx; font-size: 26rpx; color: #52c41a; }
.empty { text-align: center; color: #b0b4bf; font-size: 26rpx; padding: 60rpx 24rpx; }
.sec-title { margin: 32rpx 8rpx 8rpx; font-size: 28rpx; font-weight: 600; color: #5f6572; }
.r-title { font-size: 28rpx; font-weight: 700; margin-bottom: 8rpx; }
.m { display: flex; align-items: center; justify-content: space-between; padding: 16rpx 0; border-top: 1rpx solid #f0f1f5; }
.m:first-child { border-top: none; }
.m-teams { font-size: 30rpx; font-weight: 600; }
.vs { color: #8a8f99; font-size: 24rpx; margin: 0 8rpx; }
.m-meta { margin-top: 4rpx; font-size: 22rpx; color: #8a8f99; }
