<view class="page">
  <view class="head">
    <view class="head-actions">
      <view class="new-btn" bindtap="goCreate">＋ 新建赛事</view>
      <view class="dash-btn" bindtap="goDashboard">数据看板</view>
    </view>
  </view>

  <view class="section-title">办赛流水线</view>
  <view class="steps">
    <view
      class="step card"
      wx:for="{{steps}}"
      wx:key="key"
      data-path="{{item.path}}"
      bindtap="onStepTap"
    >
      <view class="step-idx">{{index + 1}}</view>
      <view class="step-body">
        <view class="step-name">{{item.name}}</view>
        <view class="step-desc">{{item.desc}}</view>
      </view>
      <view class="step-arrow">›</view>
    </view>
  </view>

  <view wx:if="{{events.length}}">
    <view class="section-title">我举办的赛事</view>
    <view
      class="card event-item"
      wx:for="{{events}}"
      wx:key="_id"
      data-id="{{item._id}}"
      bindtap="goDetail"
    >
      <view class="event-name">{{item.name}}</view>
      <view class="event-meta">{{item.statusText}}</view>
    </view>
  </view>
</view>