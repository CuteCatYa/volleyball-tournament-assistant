.page { padding: 24rpx; padding-bottom: 80rpx; }
.sec { font-size: 28rpx; font-weight: 600; margin-bottom: 8rpx; }
.f-row { display: flex; align-items: center; padding: 18rpx 0; border-bottom: 1rpx solid #f0f1f5; }
.f-label { width: 170rpx; font-size: 26rpx; color: #5f6572; flex-shrink: 0; }
.f-picker { flex: 1; text-align: right; color: #2f54eb; font-size: 28rpx; }
.f-value { flex: 1; text-align: right; font-size: 28rpx; }
.btn-primary { margin-top: 20rpx; background: #2f54eb; color: #fff; border-radius: 999rpx; font-size: 30rpx; font-weight: 600; }
.btn-ghost { margin-top: 16rpx; background: #fff; color: #2f54eb; border: 2rpx solid #2f54eb; border-radius: 999rpx; font-size: 28rpx; }
.warn { margin: 16rpx 0; padding: 16rpx 20rpx; background: #fffbe6; color: #d48806; border-radius: 12rpx; font-size: 24rpx; }
.sec-title { margin: 32rpx 8rpx 8rpx; font-size: 28rpx; font-weight: 600; color: #5f6572; }
.empty { text-align: center; color: #b0b4bf; font-size: 26rpx; padding: 40rpx; }
.g-name { font-size: 30rpx; font-weight: 700; margin-bottom: 8rpx; }
.g-team { font-size: 28rpx; padding: 8rpx 0; }
.g-unit { margin-left: 16rpx; font-size: 22rpx; color: #8a8f99; }
