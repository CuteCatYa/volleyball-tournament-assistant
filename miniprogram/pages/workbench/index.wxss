.page { padding-bottom: 40rpx; }
.sec-title { margin: 32rpx 32rpx 8rpx; font-size: 28rpx; font-weight: 600; color: #5f6572; display: flex; align-items: center; justify-content: space-between; }
.link { font-size: 24rpx; color: #2f54eb; font-weight: 400; }
.ev-scroll { white-space: nowrap; padding: 16rpx 24rpx 8rpx; box-sizing: border-box; }
.ev-chip { display: inline-block; padding: 16rpx 32rpx; background: #fff; border-radius: 999rpx; margin-right: 16rpx; font-size: 26rpx; color: #5f6572; }
.ev-chip-active { background: #2f54eb; color: #fff; }
.empty-inline { display: inline-block; color: #b0b4bf; font-size: 24rpx; padding: 12rpx 0; }
.step { display: flex; align-items: center; justify-content: space-between; }
.step-name { font-size: 30rpx; font-weight: 600; }
.step-desc { font-size: 24rpx; color: #8a8f99; margin-top: 4rpx; }
