.page {
  padding: 24rpx;
}

.tip {
  font-size: 26rpx;
  color: #8a8f99;
  padding: 0 8rpx;
  margin-bottom: 24rpx;
}

.chips {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.chip {
  background: #eef1ff;
  color: #2f54eb;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  line-height: 1.5;
}

.input-box {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.input {
  width: 100%;
  min-height: 160rpx;
  font-size: 30rpx;
  line-height: 1.6;
}

.submit {
  margin-top: 16rpx;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 999rpx;
  background: #2f54eb;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
}

.result {
  margin: 24rpx 0;
}

.result-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.result-text {
  font-size: 26rpx;
  color: #5f6572;
  line-height: 1.6;
  white-space: pre-wrap;
}

.mode {
  margin: 16rpx 0;
}

.mode-name {
  font-size: 30rpx;
  font-weight: 600;
}

.mode-desc {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #8a8f99;
}

/* ---- 草稿卡表单 ---- */

.ai-flag {
  font-size: 24rpx;
  color: #d48806;
  background: #fffbe6;
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
  margin-bottom: 16rpx;
}

.form-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f1f5;
}

.form-row:last-child {
  border-bottom: none;
}

.form-label {
  width: 180rpx;
  font-size: 28rpx;
  color: #5f6572;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  text-align: right;
}

.form-picker {
  flex: 1;
  font-size: 28rpx;
  text-align: right;
  color: #2f54eb;
}

.summary {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #8a8f99;
  line-height: 1.6;
}

.confirm {
  margin-top: 24rpx;
  background: #2f54eb;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 999rpx;
}