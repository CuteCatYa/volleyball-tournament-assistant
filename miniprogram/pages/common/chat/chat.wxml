<view class="chat">
  <scroll-view class="msgs" scroll-y scroll-into-view="{{scrollIntoView}}">
    <view
      class="msg {{item.role}}"
      wx:for="{{messages}}"
      wx:key="index"
      id="{{index === messages.length - 1 ? 'msg-last' : ''}}"
    >
      <view class="bubble">{{item.text}}</view>
    </view>
    <view class="msg ai" wx:if="{{loading}}">
      <view class="bubble">思考中…</view>
    </view>
  </scroll-view>

  <view class="composer">
    <input
      class="composer-input"
      value="{{input}}"
      bindinput="onInput"
      bindconfirm="send"
      confirm-type="send"
      placeholder="输入问题，如：我们队明天几点打？"
    />
    <view class="composer-send" bindtap="send">发送</view>
  </view>
</view>