.page {
  padding-bottom: 40rpx;
}

.hero {
  margin: 24rpx;
  padding: 48rpx 32rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #2f54eb, #722ed1);
  color: #fff;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 700;
}

.hero-sub {
  margin-top: 8rpx;
  font-size: 26rpx;
  opacity: 0.85;
}

.hero-actions {
  margin-top: 32rpx;
  display: flex;
  gap: 20rpx;
}

.hero-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 999rpx;
  background: #fff;
  color: #2f54eb;
  font-size: 28rpx;
  font-weight: 600;
}

.hero-btn.ghost {
  background: rgba(255, 255, 255, 0.18);
  color: #fff;
  border: 1rpx solid rgba(255, 255, 255, 0.5);
}

.section-title {
  margin: 24rpx 24rpx 8rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.event-item {
  margin-top: 16rpx;
}

.event-name {
  font-size: 32rpx;
  font-weight: 600;
}

.event-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
}

.empty {
  margin-top: 120rpx;
  text-align: center;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 600;
}

.empty-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
}

.empty-btn {
  display: inline-block;
  margin-top: 32rpx;
  padding: 16rpx 56rpx;
  border-radius: 999rpx;
  background: #2f54eb;
  color: #fff;
  font-size: 30rpx;
}