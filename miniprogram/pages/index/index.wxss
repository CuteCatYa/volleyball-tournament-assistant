.page { padding-bottom: 40rpx; }
.hero { background: linear-gradient(135deg, #2f54eb, #5b8cff); border-radius: 24rpx; margin: 24rpx; padding: 40rpx 32rpx; color: #fff; }
.hero-title { font-size: 40rpx; font-weight: 700; }
.hero-sub { margin-top: 12rpx; font-size: 24rpx; opacity: 0.85; line-height: 1.5; }
.hero-btn { margin-top: 32rpx; display: inline-block; background: #fff; color: #2f54eb; font-size: 28rpx; font-weight: 600; padding: 16rpx 40rpx; border-radius: 999rpx; }
.sec-title { margin: 32rpx 32rpx 8rpx; font-size: 28rpx; font-weight: 600; color: #5f6572; }
.empty { text-align: center; color: #b0b4bf; font-size: 26rpx; padding: 60rpx 24rpx; }
.event-card { margin: 16rpx 24rpx; }
.event-top { display: flex; align-items: center; justify-content: space-between; }
.event-name { font-size: 32rpx; font-weight: 600; flex: 1; margin-right: 12rpx; }
.event-sub { margin-top: 6rpx; font-size: 24rpx; color: #8a8f99; }
.event-step { margin-top: 10rpx; font-size: 24rpx; color: #2f54eb; }
