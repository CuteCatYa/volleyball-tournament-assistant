<view class="page">
  <view class="empty" wx:if="{{!loading && !notices.length}}">暂无消息（公告发布后显示在这里）</view>
  <view class="card" wx:for="{{notices}}" wx:key="_id" data-eventid="{{item.eventId}}" bindtap="goEvent">
    <view class="n-title">{{item.title}}</view>
    <view class="n-content">{{item.content}}</view>
    <view class="n-meta">{{item.eventName}} · {{item.timeText}}</view>
  </view>
</view>
