<view class="page">
  <view class="chat-entry" bindtap="goChat">
    <view class="chat-avatar">AI</view>
    <view class="chat-body">
      <view class="chat-title">赛事 AI 助手</view>
      <view class="chat-sub">问赛程、规则、成绩，秒回并附来源</view>
    </view>
    <view class="chat-arrow">›</view>
  </view>

  <view class="section-title">通知</view>
  <view wx:if="{{notices.length}}">
    <view class="cell" wx:for="{{notices}}" wx:key="_id">
      <view class="cell-body">
        <view class="cell-title">{{item.title}}</view>
        <view class="cell-sub">{{item.content}}</view>
        <view class="cell-time">{{item.timeText}}</view>
      </view>
    </view>
  </view>

  <view class="empty" wx:else>暂无通知</view>
</view>